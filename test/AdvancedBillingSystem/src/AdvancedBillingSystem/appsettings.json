{
  "ConnectionStrings": {
    "BillingDb": "Server=localhost;Database=BillingDb;User Id=your_username;Password=your_password;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "MultiTenant": {
    "Enable": true,
    "DefaultTenant": "default_tenant"
  },
  "BillingStrategies": {
    "DefaultStrategy": "FixedFee"
  },
  "Discounts": {
    "EnableDiscounts": true,
    "DefaultDiscount": "None"
  }
}